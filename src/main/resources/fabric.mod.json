{
	"schemaVersion": 1,
	"id": "lavasurvival",
	"version": "${version}",
	"name": "Lava Survival",
	"description": "The minigame popular in Minecraft Classic remade in Modern Minecraft using Plasmid!",
	"authors": [
		"PoeticRainbow"
	],
	"contact": {
		"sources": "https://github.com/PoeticRainbow/lava-survival"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"poeticrainbow.lavasurvival.LavaSurvival"
		],
		"fabric-datagen": [
			"poeticrainbow.lavasurvival.LavaSurvivalDataGenerator"
		]
	},
	"accessWidener": "lavasurvival.accesswidener",
	"depends": {
		"fabricloader": ">=0.16.0",
		"java": ">=21",
    	"plasmid": "0.6.x"
	},
	"mixins": ["lavasurvival.mixins.json"]
}